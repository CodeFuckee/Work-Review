{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "deb",
      "rpm",
      "appimage"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "icon": [
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "copyright": "© 2026 WorkReview",
    "category": "Productivity",
    "shortDescription": "工作回顾与AI日报助手",
    "longDescription": "一个高性能、低占用的工作活动追踪与AI日报生成工具，帮你记录每天的辛勤付出。",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "exceptionDomain": "",
      "signingIdentity": "WorkReview Self-Signed",
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "xdotool",
          "xprintidle",
          "x11-utils",
          "libglib2.0-bin",
          "tesseract-ocr",
          "gnome-screenshot | grim | scrot | maim | imagemagick",
          "procps"
        ]
      },
      "rpm": {
        "depends": [
          "xdotool",
          "xprintidle",
          "xorg-x11-utils",
          "glib2",
          "tesseract",
          "gnome-screenshot",
          "procps-ng"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "productName": "Yue-Review",
  "mainBinaryName": "Yue_Review",
  "version": "1.1.98",
  "identifier": "com.yuereview.app",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhBOTFGOUMyNTQ2NzI2NjcKUldSbkptZFV3dm1SaXVWQnAzcW9SNVFBWEdyR2tycXVvVWsvN2YraUV2S0ZOaHo4K3Jyd2RmSkoK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Yue复盘",
        "width": 1000,
        "height": 700,
        "visible": false,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "hiddenTitle": true,
        "transparent": false,
        "alwaysOnTop": false,
        "dragDropEnabled": false,
        "useHttpsScheme": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --allow-running-insecure-content --unsafely-treat-insecure-origin-as-secure=http://10.37.80.25:4191"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* http://10.37.80.25:*"
    }
  }
}
