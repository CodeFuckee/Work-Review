{
  "name": "work-review",
  "private": true,
  "version": "1.2.24",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild": true
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test:frontend": "node --import tsx --test \"**/*.test.ts\"",
    "verify:frontend": "npm run check && npm run test:frontend && npm run build",
    "preview": "vite preview",
    "icons:build": "node --import tsx scripts/build-icons.ts",
    "icons:providers": "node --import tsx scripts/fetch-provider-icons.ts",
    "star-history": "node --import tsx scripts/capture-star-history.ts",
    "tauri": "tauri",
    "tauri:dev": "node scripts/tauri-dev-with-key.mjs",
    "tauri:dev:raw": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:local-mac": "tauri build --target aarch64-apple-darwin --bundles app --config src-tauri/tauri.local.conf.json",
    "test:frontend:coverage": "node --import tsx --test --experimental-test-coverage \"**/*.test.ts\""
  },
  "devDependencies": {
    "@ibm/plex-sans": "^1.1.0",
    "@ibm/plex-sans-arabic": "^1.1.0",
    "@playwright/test": "^1.61.1",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@tauri-apps/cli": "^2.10.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^22.20.1",
    "autoprefixer": "^10.4.0",
    "playwright": "1.61.1",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-dialog": "2.7.0",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-shell": "2.3.4",
    "carbon-components-svelte": "^0.113.1",
    "carbon-icons-svelte": "^13.16.0",
    "dompurify": "^3.4.12",
    "marked": "^11.0.0",
    "svelte-spa-router": "^4.0.0"
  }
}
